{
  "expo": {
    "name": "AutoRent",
    "slug": "autorent",
    "scheme": "autorent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0B0D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autorent.app"
    },
    "android": {
      "package": "com.autorent.app"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.autorent",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
