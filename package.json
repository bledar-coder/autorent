{
  "name": "autorent",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@autorent/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @autorent/web exec prisma migrate dev",
    "db:seed": "pnpm --filter @autorent/web exec prisma db seed",
    "db:studio": "pnpm --filter @autorent/web exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.8",
    "typescript": "^5.7.3"
  }
}
