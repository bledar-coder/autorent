# ---------------------------------------------------------------------------
# AutoRent environment variables. Copy to apps/web/.env and fill in.
# Never commit real values.
# ---------------------------------------------------------------------------

# Database (PostgreSQL) -------------------------------------------------------
# Local Postgres or a managed provider (Neon, Supabase, Railway, RDS).
DATABASE_URL="postgresql://user:password@localhost:5432/autorent?schema=public"

# Auth (Better Auth) ----------------------------------------------------------
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments (Stripe) -----------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Storage (S3-compatible) -----------------------------------------------------
# Private bucket holds license/ID uploads + condition photos (signed URLs only).
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_PUBLIC="autorent-public"
S3_BUCKET_PRIVATE="autorent-private"

# Monitoring & analytics ------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# App -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="sq"
